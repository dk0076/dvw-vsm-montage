{
  "name": "dvw-vsm-montage",
  "version": "28.0.0",
  "private": true,
  "description": "Single-file browser tool that cuts coach-review video from coded volleyball match files",
  "main": "desktop/main.js",
  "scripts": {
    "test": "node test/smoke.js && node test/zones.js",
    "test:zones": "node test/zones.js",
    "test:exe": "node test/exe-smoke.js",
    "rebaseline": "node tools/rebaseline.js",
    "app": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.dk0076.montage",
    "productName": "montage",
    "files": [
      "montage.html",
      "desktop/main.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
